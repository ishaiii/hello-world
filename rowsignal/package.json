{
  "name": "rowsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RowSignal — compare spreadsheets, resolve differences. Local-first spreadsheet reconciliation.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/public-site/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "tsc --noEmit && npm run build:client && npm run build:ssr && npm run prerender && npm run check:dist",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "lucide-react": "1.51.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "exceljs": "4.4.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
