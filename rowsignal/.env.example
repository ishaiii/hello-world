# Copy to .env.production (or set in your host's build settings). No secrets belong here:
# every VITE_* value is compiled into public client code.

# Verified production origin of the PUBLIC site, no trailing slash. Enables canonical URLs, Open Graph
# URLs, structured data and sitemap.xml. Leave empty until the real domain is configured and verified.
VITE_SITE_URL=

# Optional: host the workspace on a different origin from the public pages.
#   Public build:     VITE_APP_URL=https://app.example.com
#   Workspace build:  VITE_PUBLIC_URL=https://www.example.com
VITE_APP_URL=
VITE_PUBLIC_URL=

# Owner-supplied identity/contact shown on Privacy, Terms, About and Contact. Leave empty if none yet.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=

# Advertising integration points. Off by default. Never loaded in the workspace.
# Enabling requires a real publisher id AND a consent implementation (docs/ADS_AND_ANALYTICS.md).
VITE_ADS_ENABLED=false
VITE_ADS_PUBLISHER_ID=
